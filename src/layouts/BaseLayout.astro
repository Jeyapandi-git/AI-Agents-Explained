---
import '../styles/global.css';
const { title = 'AI Agents Explained', description = 'Clear explanations and practical examples of AI agent technology.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = '') => `${base}${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <title>{title === 'AI Agents Explained' ? title : `${title} | AI Agents Explained`}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href={link('')}>AI Agents Explained</a>
        <nav aria-label="Main navigation">
          <a href={link('')}>Home</a>
          <a href={link('blog/')}>Articles</a>
          <a href={link('about/')}>About</a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer"><div class="shell">© {new Date().getFullYear()} AI Agents Explained · <a href={link('about/')}>About the author</a></div></footer>
  </body>
</html>
