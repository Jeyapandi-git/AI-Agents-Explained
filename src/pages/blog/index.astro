---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import { getCollection } from 'astro:content';
import { publishedLabel } from '../../utils/date';
const base=import.meta.env.BASE_URL;
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Articles">
  <h1>Articles</h1>
  <div class="reading-layout">
    <ArticleSidebar />
    <div class="reading-content">
      {posts.map(post=><div class="article-preview">
        <p class="meta"><time datetime={post.data.pubDate.toISOString()}>{publishedLabel(post.data.pubDate,false)}</time> · {post.data.category}</p>
        <h2><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </div>)}
    </div>
  </div>
</BaseLayout>
