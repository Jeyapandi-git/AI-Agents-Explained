---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import { getCollection } from 'astro:content';
import { publishedLabel } from '../utils/date';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest = posts[0];
---
<BaseLayout>
  <h1>AI Agents Explained</h1>
  <p class="lede">Clear explanations, practical examples, and real-world applications of AI Agent technology.</p>
  <div class="reading-layout">
    <ArticleSidebar activeId={latest?.id} />
    <div class="reading-content">
      {latest ? <>
        <p class="meta"><time datetime={latest.data.pubDate.toISOString()}>{publishedLabel(latest.data.pubDate, false)}</time> · {latest.data.category}</p>
        <h2 class="featured-title"><a href={`${base}blog/${latest.id}/`}>{latest.data.title}</a></h2>
        <p>{latest.data.description}</p>
        <a href={`${base}blog/${latest.id}/`}>Read article →</a>
      </> : <p>Articles will appear here when published.</p>}
    </div>
  </div>
</BaseLayout>
